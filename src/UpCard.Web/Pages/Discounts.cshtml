@page
@model DiscountsModel
@{
    ViewData["Title"] = "Discounts";
}

<div class="uc-actions" style="justify-content:space-between;margin-bottom:8px">
    <div>
        <h1 class="uc-page-title" style="margin:0">Discounts</h1>
        <p class="uc-page-sub" style="margin:6px 0 0">Triggered rewards · free shipping · % off · free gifts</p>
    </div>
    <a class="uc-btn uc-btn-primary" asp-page="/DiscountEdit">+ Create discount</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="uc-alert uc-alert-ok">@Model.Message</div>
}

<div class="uc-card" style="margin-bottom:16px">
    <div class="uc-card-hd"><h2>Live discounts</h2></div>
    @if (!Model.Live.Any())
    {
        <div class="uc-card-bd" style="color:var(--uc-muted)">No live discounts. Publish a discount from your drafts to make it live.</div>
    }
    else
    {
        <table class="uc-table">
            <thead><tr><th>Name</th><th>Triggers</th><th>Rewards</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Live)
            {
                <tr>
                    <td><strong>@r.Name</strong></td>
                    <td>@DiscountsModel.TriggerSummary(r)</td>
                    <td><span class="uc-badge uc-badge-live">@DiscountsModel.RewardSummary(r)</span></td>
                    <td class="uc-actions">
                        <a class="uc-btn uc-btn-secondary uc-btn-sm" asp-page="/DiscountEdit" asp-route-id="@r.Id">Edit</a>
                        <form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@r.Id" /><button class="uc-btn uc-btn-danger uc-btn-sm">Delete</button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="uc-card" style="margin-bottom:16px">
    <div class="uc-card-hd"><h2>Draft discounts</h2></div>
    @if (!Model.Draft.Any())
    {
        <div class="uc-card-bd" style="color:var(--uc-muted)">No draft discounts. Discounts created here won't go live until you publish them.</div>
    }
    else
    {
        <table class="uc-table">
            <thead><tr><th>Name</th><th>Triggers</th><th>Rewards</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Draft)
            {
                <tr>
                    <td><strong>@r.Name</strong></td>
                    <td>@DiscountsModel.TriggerSummary(r)</td>
                    <td><span class="uc-badge uc-badge-draft">@DiscountsModel.RewardSummary(r)</span></td>
                    <td>
                        <div class="uc-actions">
                            <a class="uc-btn uc-btn-secondary uc-btn-sm" asp-page="/DiscountEdit" asp-route-id="@r.Id">Edit</a>
                            <form method="post" asp-page-handler="Publish"><input type="hidden" name="id" value="@r.Id" /><button class="uc-btn uc-btn-primary uc-btn-sm">Publish</button></form>
                            <form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@r.Id" /><button class="uc-btn uc-btn-danger uc-btn-sm">Delete</button></form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="uc-card">
    <div class="uc-card-hd"><h2>Discount combinations</h2></div>
    <div class="uc-card-bd">
        <label class="uc-check" style="display:block;margin-bottom:10px"><input type="checkbox" disabled /> <strong>Product discounts</strong> — applies alongside other product-level discounts</label>
        <label class="uc-check" style="display:block;margin-bottom:10px"><input type="checkbox" disabled /> <strong>Order discounts</strong> — product discounts first, then order-level</label>
        <label class="uc-check" style="display:block"><input type="checkbox" disabled /> <strong>Shipping discounts</strong> — combine with free shipping for largest eligible discount</label>
        <p class="hint" style="margin-top:12px;color:var(--uc-muted);font-size:12px">Combination toggles sync to Shopify Discount API in a later release.</p>
    </div>
</div>
