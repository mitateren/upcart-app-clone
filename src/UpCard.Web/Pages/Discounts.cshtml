@page
@model DiscountsModel
@{
    ViewData["Title"] = "Discounts";
}

<h1 class="uc-page-title">Discounts</h1>
<p class="uc-page-sub">Spend thresholds · free gift · free shipping kuralları</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="uc-alert uc-alert-ok">@Model.Message</div>
}

<div class="uc-card" style="margin-bottom:16px">
    <div class="uc-card-hd"><h2>Yeni kural</h2></div>
    <div class="uc-card-bd">
        <form method="post" asp-page-handler="Create" class="uc-grid uc-grid-2">
            <div class="uc-field"><label>Name</label><input class="uc-input" name="name" value="Spend & save" /></div>
            <div class="uc-field">
                <label>Type</label>
                <select class="uc-select" name="ruleType">
                    <option value="discount">Discount %</option>
                    <option value="free_gift">Free gift</option>
                    <option value="free_shipping">Free shipping</option>
                </select>
            </div>
            <div class="uc-field"><label>Min cart total</label><input class="uc-input" name="minCartTotal" value="50" /></div>
            <div class="uc-field"><label>Discount %</label><input class="uc-input" name="discountPercent" value="10" /></div>
            <div><button class="uc-btn uc-btn-primary" type="submit">Create rule</button></div>
        </form>
    </div>
</div>

<div class="uc-card">
    <table class="uc-table">
        <thead><tr><th>Name</th><th>Type</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rules)
        {
            <tr>
                <td>
                    <strong>@r.Name</strong>
                    <div style="font-size:11px;color:#6d7175;margin-top:4px">@r.ConditionsJson</div>
                </td>
                <td>@r.RuleType</td>
                <td><span class="uc-badge @(r.Enabled ? "uc-badge-on" : "uc-badge-off")">@(r.Enabled ? "enabled" : "off")</span></td>
                <td>
                    <div class="uc-actions">
                        <form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@r.Id" /><button class="uc-btn uc-btn-secondary uc-btn-sm">Toggle</button></form>
                        <form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@r.Id" /><button class="uc-btn uc-btn-danger uc-btn-sm">Delete</button></form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
