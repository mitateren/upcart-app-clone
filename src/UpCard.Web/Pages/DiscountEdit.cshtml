@page "{id?}"
@model DiscountEditModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Id) ? "İndirim oluştur" : "İndirimi düzenle";
}

<div class="uc-actions" style="justify-content:space-between;margin-bottom:16px">
    <div class="uc-actions">
        <a class="uc-btn uc-btn-secondary" asp-page="/Discounts">←</a>
        <h1 class="uc-page-title" style="margin:0">@ViewData["Title"]</h1>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />

    <div class="uc-card" style="margin-bottom:16px">
        <div class="uc-card-hd"><h2>Genel</h2></div>
        <div class="uc-card-bd">
            <p style="margin-top:0;color:var(--uc-muted);font-size:13px">Bu alanlar mağaza ön yüzündeki sepet şablonunda da kullanılır.</p>
            <div class="uc-field"><label>Başlık *</label><input class="uc-input" asp-for="Title" maxlength="50" /></div>
            <div class="uc-field"><label>İndirim kodu *</label><input class="uc-input" asp-for="Code" maxlength="25" /></div>
            <div class="uc-field"><label>Açıklama *</label><textarea class="uc-textarea" asp-for="Description" rows="3"></textarea></div>
        </div>
    </div>

    <div class="uc-card" style="margin-bottom:16px">
        <div class="uc-card-hd"><h2>Tetikleyiciler (en fazla 2)</h2></div>
        <div class="uc-card-bd">
            <p style="margin-top:0;color:var(--uc-muted);font-size:13px">Ödül sunmak için sağlanması gereken koşullar.</p>
            <div class="uc-grid uc-grid-2">
                <div class="uc-field">
                    <label>Tetikleyici 1</label>
                    <select class="uc-select" asp-for="TriggerType">
                        <option value="cart_total">Sepet tutarı</option>
                        <option value="cart_quantity">Sepet adedi</option>
                        <option value="products">Belirli ürünler</option>
                        <option value="collections">Belirli koleksiyonlar</option>
                        <option value="subscription">Abonelik</option>
                        <option value="logged_in">Müşteri giriş yapmış</option>
                    </select>
                </div>
                <div class="uc-field"><label>Minimum tutar / adet</label><input class="uc-input" type="number" asp-for="TriggerMin" /></div>
                <div class="uc-field">
                    <label>Tetikleyici 2 (isteğe bağlı)</label>
                    <select class="uc-select" asp-for="TriggerType2">
                        <option value="">— yok —</option>
                        <option value="cart_total">Sepet tutarı</option>
                        <option value="cart_quantity">Sepet adedi</option>
                        <option value="products">Belirli ürünler</option>
                        <option value="collections">Belirli koleksiyonlar</option>
                        <option value="subscription">Abonelik</option>
                        <option value="logged_in">Müşteri giriş yapmış</option>
                    </select>
                </div>
                <div class="uc-field"><label>Minimum 2</label><input class="uc-input" type="number" asp-for="TriggerMin2" /></div>
            </div>
        </div>
    </div>

    <div class="uc-card" style="margin-bottom:16px">
        <div class="uc-card-hd"><h2>Ödül</h2></div>
        <div class="uc-card-bd">
            <div class="uc-grid uc-grid-2">
                <div class="uc-field">
                    <label>Ödül türü</label>
                    <select class="uc-select" asp-for="RewardType">
                        <option value="free_shipping">Ücretsiz kargo</option>
                        <option value="percentage">Yüzde (%)</option>
                        <option value="fixed">Sabit tutar</option>
                        <option value="free_gift">Hediye ürün</option>
                    </select>
                </div>
                <div class="uc-field"><label>Değer (% veya tutar)</label><input class="uc-input" type="number" asp-for="RewardValue" /></div>
            </div>
        </div>
    </div>

    <div class="uc-actions" style="justify-content:flex-end">
        <button class="uc-btn uc-btn-secondary" type="submit" asp-page-handler="SaveDraft">Taslak kaydet</button>
        <button class="uc-btn uc-btn-primary" type="submit" asp-page-handler="Publish">Yayınla ve çık</button>
    </div>
</form>
