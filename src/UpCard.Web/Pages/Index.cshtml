@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    // Upcart home redirects conceptually to dashboard — keep as welcome hub
}

@if (Model.NeedsInstall)
{
    <h1 class="uc-page-title">Welcome to UpCard</h1>
    <p class="uc-page-sub">Shopify Admin içinden uygulamayı aç veya mağaza domain’ini gir.</p>
    <div class="uc-card">
        <div class="uc-card-bd">
            <form method="get" action="/auth/install" class="uc-grid uc-grid-2" style="align-items:end">
                <div class="uc-field" style="margin:0">
                    <label>Shop domain</label>
                    <input class="uc-input" name="shop" placeholder="magaza.myshopify.com" required />
                </div>
                <button class="uc-btn uc-btn-primary" type="submit">Install</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="uc-actions" style="justify-content:space-between;margin-bottom:8px">
        <h1 class="uc-page-title" style="margin:0">Welcome to UpCard 🎉</h1>
        <div class="uc-actions">
            <span class="uc-badge uc-badge-draft">Last 30 days</span>
            <a class="uc-btn uc-btn-secondary" asp-page="/Carts">Manage all carts</a>
        </div>
    </div>
    <p class="uc-page-sub">@Model.Shop</p>

    <div class="uc-grid uc-grid-3" style="margin-bottom:16px">
        <div class="uc-card uc-metric"><div class="label">Add-ons revenue</div><div class="value">0.00TL</div></div>
        <div class="uc-card uc-metric"><div class="label">Upsell revenue</div><div class="value">0.00TL</div></div>
        <div class="uc-card uc-metric"><div class="label">Subscriptions revenue</div><div class="value">0.00TL</div></div>
    </div>

    <div class="uc-card" style="margin-bottom:16px">
        <div class="uc-card-bd">
            <div class="uc-actions" style="justify-content:space-between;margin-bottom:10px">
                <div>
                    <strong>Live carts</strong>
                    <span class="uc-badge @(Model.LiveCartStatus == "live" ? "uc-badge-live" : "uc-badge-draft")" style="margin-left:8px">
                        @(Model.LiveCartStatus == "live" ? Model.LiveCartName : "No live carts configured")
                    </span>
                    <span class="uc-badge uc-badge-off" style="margin-left:6px">App embed check</span>
                </div>
            </div>
            <p style="color:var(--uc-muted);margin:0 0 14px">Publish your cart to see it live, and start earning with your cart.</p>
            <div class="uc-actions">
                <a class="uc-btn uc-btn-primary" href="https://admin.shopify.com/store/@Model.Shop.Replace(".myshopify.com","")/themes/current/editor?context=apps" target="_blank" rel="noopener">Enable app embed</a>
                <a class="uc-btn uc-btn-secondary" asp-page="/Carts">Manage carts</a>
                <a class="uc-btn uc-btn-secondary" asp-page="/Onboarding">Setup wizard</a>
            </div>
        </div>
    </div>

    <div class="uc-grid uc-grid-2">
        <div class="uc-card">
            <div class="uc-card-hd"><h2>Discounts</h2><a class="uc-btn uc-btn-secondary uc-btn-sm" asp-page="/Discounts">Manage all discounts</a></div>
            <div class="uc-card-bd" style="color:var(--uc-muted)">Create triggered rewards (free shipping, % off, free gifts) like Upcart Discounts.</div>
        </div>
        <div class="uc-card">
            <div class="uc-card-hd"><h2>Setup guide</h2><span class="uc-badge uc-badge-live">1 of 5</span></div>
            <div class="uc-card-bd">
                <ol class="uc-steps">
                    <li>Run setup wizard (style + modules)</li>
                    <li>Enable <strong>UpCard Bridge</strong> app embed</li>
                    <li>Publish a cart</li>
                    <li>Create a discount rule</li>
                    <li>Turn on sticky cart</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="uc-grid uc-grid-4" style="margin-top:16px">
        <div class="uc-card uc-metric"><div class="label">Cart opens</div><div class="value">@Model.Opens</div></div>
        <div class="uc-card uc-metric"><div class="label">Upsell adds</div><div class="value">@Model.Upsells</div></div>
        <div class="uc-card uc-metric"><div class="label">Checkouts</div><div class="value">@Model.Checkouts</div></div>
        <div class="uc-card uc-metric"><div class="label">Upsell CTR</div><div class="value">@Model.UpsellCtr%</div></div>
    </div>
}
