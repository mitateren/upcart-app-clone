@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@if (Model.NeedsInstall)
{
    <h1 class="uc-page-title">UpCard’a hoş geldin</h1>
    <p class="uc-page-sub">Shopify Admin içinden uygulamayı aç veya mağaza domain’ini gir.</p>
    <div class="uc-card">
        <div class="uc-card-bd">
            <form method="get" action="/auth/install" class="uc-grid uc-grid-2" style="align-items:end">
                <div class="uc-field" style="margin:0">
                    <label>Shop domain</label>
                    <input class="uc-input" name="shop" placeholder="magaza.myshopify.com" required />
                </div>
                <button class="uc-btn uc-btn-primary" type="submit">Kur / Giriş</button>
            </form>
        </div>
    </div>
}
else
{
    <h1 class="uc-page-title">Home</h1>
    <p class="uc-page-sub">@Model.Shop · Canlı sepet: <strong>@Model.LiveCartName</strong>
        <span class="uc-badge @(Model.LiveCartStatus == "live" ? "uc-badge-live" : "uc-badge-draft")">@Model.LiveCartStatus</span>
    </p>

    <div class="uc-grid uc-grid-4" style="margin-bottom:18px">
        <div class="uc-card uc-metric"><div class="label">Cart opens</div><div class="value">@Model.Opens</div></div>
        <div class="uc-card uc-metric"><div class="label">Upsell adds</div><div class="value">@Model.Upsells</div></div>
        <div class="uc-card uc-metric"><div class="label">Checkout clicks</div><div class="value">@Model.Checkouts</div></div>
        <div class="uc-card uc-metric"><div class="label">Upsell CTR</div><div class="value">@Model.UpsellCtr%</div></div>
    </div>

    <div class="uc-grid uc-grid-2">
        <div class="uc-card">
            <div class="uc-card-hd"><h2>Hızlı işlemler</h2></div>
            <div class="uc-card-bd uc-actions">
                <a class="uc-btn uc-btn-primary" asp-page="/Editor">Cart Editor</a>
                <a class="uc-btn uc-btn-secondary" asp-page="/Carts">Manage Carts</a>
                <a class="uc-btn uc-btn-secondary" asp-page="/Discounts">Discounts</a>
                <a class="uc-btn uc-btn-secondary" asp-page="/Analytics">Analytics</a>
            </div>
        </div>
        <div class="uc-card">
            <div class="uc-card-hd"><h2>Kurulum (Upcart gibi)</h2></div>
            <div class="uc-card-bd">
                <ol class="uc-steps">
                    <li>Themes → Customize → <strong>App embeds → UpCard Bridge</strong> aç</li>
                    <li>Cart Editor’da Design, Rewards, Upsells, Add-ons modüllerini ayarla</li>
                    <li>Manage Carts → Publish</li>
                    <li>Storefront’ta ürün ekle → slide cart’ı doğrula</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="uc-card" style="margin-top:16px">
        <div class="uc-card-hd"><h2>Özellikler</h2></div>
        <div class="uc-card-bd" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;font-size:13px">
            <div>✓ Slide cart drawer</div>
            <div>✓ Rewards / free shipping bar</div>
            <div>✓ In-cart upsells</div>
            <div>✓ Announcements + timer</div>
            <div>✓ Add-ons</div>
            <div>✓ Discount codes</div>
            <div>✓ Trust badges</div>
            <div>✓ Sticky cart</div>
            <div>✓ Custom CSS / HTML</div>
            <div>✓ Multicart publish</div>
            <div>✓ Analytics events</div>
            <div>✓ ATC intercept</div>
        </div>
    </div>
}
